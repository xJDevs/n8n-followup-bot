    {
      "id": "ycl-ids",
      "name": "IDs To Query",
      "notes": "One-off diagnostic from 2026-09-07. Can be deleted once resolved.",
      "parameters": {
        "jsCode": "// Three sends from 2026-09-08, to find out what state YCloud has them in RIGHT NOW.\n// It separates two different causes of the webhook that never arrives:\n//   - if YCloud says 'delivered' and no webhook arrived -> the endpoint does not deliver\n//   - if it says 'sent' or 'accepted'                  -> there was nothing to notify yet\n// (Placeholder ids: replace them with real YCloud message ids before running.)\nreturn [\n  { json: { id: '000000000000000000000001', key: '1001_2026-08-19_20' } },\n  { json: { id: '000000000000000000000002', key: '1002_2026-08-19_20' } },\n  { json: { id: '000000000000000000000003', key: '1003_2026-08-19_20' } },\n];"
      },
      "position": [
        240,
        320
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "alwaysOutputData": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "CREDENTIAL_ID_2",
          "name": "YCloud API"
        }
      },
      "id": "ycl-status",
      "name": "Message Status",
      "notes": "One call per message. Returns the CURRENT status: sent, delivered, read or failed — and if it failed, errorCode and errorMessage. It was the only way to know at the time, because the delivery webhook did not exist yet.",
      "onError": "continueRegularOutput",
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        },
        "url": "=https://api.ycloud.com/v2/whatsapp/messages/{{ $json.id }}"
      },
      "position": [
